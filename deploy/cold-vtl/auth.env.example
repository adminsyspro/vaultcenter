# Install as /etc/cold-vtl/auth.env (0600). See docs/authentication.md.
COLD_VTL_LISTEN=0.0.0.0:8443
COLD_VTL_PUBLIC_URL=https://vaultcenter.example.net:8443
COLD_VTL_TLS_CERT=/etc/cold-vtl/tls/vtl.crt
COLD_VTL_TLS_KEY=/etc/cold-vtl/tls/vtl.key
# Remove all OIDC variables for local authentication only.
COLD_VTL_OIDC_ISSUER=https://sso.example.net/realms/cold-vtl
COLD_VTL_OIDC_CLIENT_ID=cold-vtl
COLD_VTL_OIDC_CLIENT_SECRET_FILE=/etc/cold-vtl/oidc-client-secret
COLD_VTL_OIDC_CA_FILE=/etc/cold-vtl/tls/ca.crt
COLD_VTL_OIDC_ADMIN_GROUP=/cold-vtl-admins
COLD_VTL_OIDC_VIEWER_GROUP=/cold-vtl-viewers
COLD_VTL_OIDC_LABEL=Keycloak
