#!/bin/sh
set -eu

attempt=0
while [ "$attempt" -lt 150 ]; do
    if [ -e /dev/tape/by-id/scsi-COLDVTL001 ] && \
       [ -e /dev/tape/by-id/cold-vtl-drive-sg ]; then
        exit 0
    fi

    attempt=$((attempt + 1))
    sleep 0.2
done

echo "cold-vtl: timed out waiting for mhVTL SCSI devices" >&2
exit 1
