+/* Register before checking so an arrival cannot be lost between the two.
+ * poll only observes readiness; VTL_POLL_AND_GET_HEADER claims commands.
+ * No LU (startup/removal) stays idle until the bounded userspace timeout.
+ */
+static __poll_t mhvtl_poll(struct file *file, poll_table *wait) {
+	unsigned int minor = iminor(file_inode(file));
+	unsigned long flags;
+	struct mhvtl_lu_info *lu;
+	struct mhvtl_queued_cmd *cmd;
+	__poll_t ready = 0;
+
+	if (minor >= DEF_MAX_MINOR_NO)
+		return EPOLLERR;
+	poll_wait(file, &command_wait[minor], wait);
+	spin_lock_irqsave(&mhvtl_hba_list_lock, flags);
+	lu = devp[minor];
+	if (lu) {
+		spin_lock(&lu->cmd_list_lock);
+		list_for_each_entry(cmd, &lu->cmd_list, queued_sibling) {
+			if (cmd->state == CMD_STATE_QUEUED) {
+				ready = EPOLLIN | EPOLLRDNORM;
+				break;
+			}
+		}
+		spin_unlock(&lu->cmd_list_lock);
+	}
+	spin_unlock_irqrestore(&mhvtl_hba_list_lock, flags);
+	return ready;
 }
 
