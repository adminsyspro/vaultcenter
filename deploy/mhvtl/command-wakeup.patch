+++ b/include/vaultcenter_command_wait.h
@@ -0,0 +1,43 @@
+#ifndef VAULTCENTER_COMMAND_WAIT_H
+#define VAULTCENTER_COMMAND_WAIT_H
+
+#include <errno.h>
+#include <poll.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <unistd.h>
+#include "vtl_common.h"
+
+struct vaultcenter_command_wait {
+	int supported;
+};
+
+static inline void vaultcenter_command_wait_init(struct vaultcenter_command_wait *wait, int fd)
+{
+	int saved_errno = errno;
+	int capabilities = ioctl(fd, VTL_GET_CAPABILITIES, 0);
+	wait->supported = capabilities >= 0 && (capabilities & VTL_CAP_COMMAND_POLL);
+	errno = saved_errno;
+}
+
+static inline void vaultcenter_command_wait_for(struct vaultcenter_command_wait *wait,
+		int fd, unsigned int timeout_us)
+{
+	if (wait->supported) {
+		struct pollfd pfd = { .fd = fd, .events = POLLIN };
+		struct timespec timeout = {
+			.tv_sec = timeout_us / 1000000,
+			.tv_nsec = (timeout_us % 1000000) * 1000
+		};
+		int ret = ppoll(&pfd, 1, &timeout, NULL);
+		if (ret < 0 && errno == EINTR)
+			return; /* Return to signal and administration handling immediately. */
+		if (ret >= 0 && !(pfd.revents & (POLLERR | POLLHUP | POLLNVAL)))
+			return;
+		/* Never busy-loop on an unsupported/broken wait implementation. */
+		wait->supported = 0;
+	}
+	usleep(timeout_us);
+}
+
+#endif
