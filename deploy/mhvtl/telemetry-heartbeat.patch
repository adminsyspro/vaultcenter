+    case MHVTL_STATE_LOADED_IDLE: return "Loaded - Idle";
+    case MHVTL_STATE_LOAD_FAILED: return "Load failed";
+    case MHVTL_STATE_REWIND: return "Rewinding";
+    case MHVTL_STATE_POSITIONING: return "Positioning";
+    case MHVTL_STATE_LOCATE: return "Locate";
+    case MHVTL_STATE_READING: return "Reading";
+    case MHVTL_STATE_WRITING: return "Writing";
+    case MHVTL_STATE_UNLOADING: return "Unloading";
+    case MHVTL_STATE_ERASE: return "Erasing";
+    case MHVTL_STATE_VERIFY: return "Verifying";
+    default: return "Initialising v2";
+    }
