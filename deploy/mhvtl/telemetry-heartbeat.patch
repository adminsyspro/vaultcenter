new file mode 100644
index 0000000..77e1056
--- /dev/null
+++ b/include/vaultcenter_telemetry.h
@@ -0,0 +1,57 @@
+/* Optional read-only VaultCenter observer. GPL-2.0-or-later, like mhVTL.
+ * Single-threaded caller; one atomic nonblocking FIFO record per second.
+ * No retry, allocation, payload access or observer dependency on tape I/O.
+ */
+#ifndef VAULTCENTER_TELEMETRY_H
+#define VAULTCENTER_TELEMETRY_H
+#include <stdio.h>
+#include <stdint.h>
+#include <inttypes.h>
+#include <unistd.h>
+#include <string.h>
+#include <errno.h>
+#include <time.h>
+
+static void vaultcenter_status_at(FILE *fifo, int queue, const char *state,
+        const char *barcode, uint64_t generation, uint64_t written,
+        uint64_t read_bytes, uint64_t at_ms, uint64_t mono_ms)
+{
+    static uint64_t emitted, previous_write, previous_read, previous_generation;
+    static uint64_t write_changed, read_changed;
+    char record[512], label[40];
+    int length;
+    if (!fifo)
+        return;
+    if (written != previous_write || generation != previous_generation)
+        write_changed = mono_ms;
+    if (read_bytes != previous_read || generation != previous_generation)
+        read_changed = mono_ms;
+    previous_write = written;
+    previous_read = read_bytes;
+    previous_generation = generation;
+    if (emitted && mono_ms - emitted < 1000)
+        return;
+    emitted = mono_ms;
+    if (!strcmp(state, "Writing") && mono_ms - write_changed >= 3000)
+        state = barcode ? "Loaded - Idle" : "Idle";
+    if (!strcmp(state, "Reading") && mono_ms - read_changed >= 3000)
+        state = barcode ? "Loaded - Idle" : "Idle";
+    strcpy(label, "null");
+    if (barcode) {
+        size_t n = strlen(barcode);
+        if (!n || n > 32 || strspn(barcode,
+                "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-") != n)
+            return;
+        snprintf(label, sizeof(label), "\"%s\"", barcode);
+    }
+    length = snprintf(record, sizeof(record),
+        "{\"vaultcenter\":1,\"queue\":%d,\"pid\":%ld,\"at_ms\":%" PRIu64
+        ",\"mono_ms\":%" PRIu64 ",\"generation\":%" PRIu64
+        ",\"bytes_written\":%" PRIu64 ",\"barcode\":%s,\"state\":\"%s\"}\n",
+        queue, (long)getpid(), at_ms, mono_ms, generation, written, label, state);
+    if (length > 0 && (size_t)length < sizeof(record)) {
+        ssize_t result = write(fileno(fifo), record, (size_t)length);
+        (void)result;
+    }
+}
+#endif
