+/* Claim before touching MAM (loading itself writes metadata). */
+int load_tape(const char *pcl, uint8_t *sam_stat) {
+ char path[4096];
+ if (vaultcenter_medium_fd >= 0 || datafile[c_pos->partition_id] >= 0) return 1;
+ if (!pcl[0] || strchr(pcl, '/') || !strcmp(pcl,".") || !strcmp(pcl,"..")) return 3;
+ if (snprintf(path,sizeof(path),"%s/%s",strlen(home_directory)?home_directory:MHVTL_HOME_PATH,pcl)>=(int)sizeof(path)) return 3;
+ vaultcenter_medium_fd=vaultcenter_media_lock(path);
+ if (vaultcenter_medium_fd<0) {
+  MHVTL_LOG(VAULTCENTER_MEDIA_LOCK_CAPABILITY ": cartridge %s is busy or inaccessible",pcl);
+  return 3;
+ }
+ int result=load_tape_locked(pcl,sam_stat);
+ if (result) {
+  /* Failed opens may have acquired a subset of descriptors. Do not rewrite
+   * corrupt metadata; close everything before releasing protection. */
+  for (int i=0;i<MAX_PARTITIONS;i++) {
+   close_partition(i);
+   free(filemarks[i]); filemarks[i]=NULL; filemark_alloc[i]=0;
+  }
+  if (mamfile>=0) {close(mamfile);mamfile=-1;}
+  if (mhvtlfile>=0) {close(mhvtlfile);mhvtlfile=-1;}
+  free(currentPCL);currentPCL=NULL;
+  close(vaultcenter_medium_fd);vaultcenter_medium_fd=-1;
+ }
+ return result;
+}
