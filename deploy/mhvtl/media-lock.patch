new file mode 100644
--- /dev/null
+++ b/include/vaultcenter_media_lock.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef VAULTCENTER_MEDIA_LOCK_H
+#define VAULTCENTER_MEDIA_LOCK_H
+#include <sys/file.h>
+#include <fcntl.h>
+#include <unistd.h>
+/* The API/worker take LOCK_SH on this same directory inode. Never unlink it
+ * or use a separately replaceable lock file. Kernel releases on process exit. */
+#define VAULTCENTER_MEDIA_LOCK_CAPABILITY "VAULTCENTER_MEDIA_LOCK_V1"
+static inline int vaultcenter_media_lock(const char *path) {
+ int fd = open(path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+ if (fd < 0) return -1;
+ if (flock(fd, LOCK_EX | LOCK_NB)) { close(fd); return -1; }
+ return fd;
+}
+#endif
